# TraceX-AI — LightningAI Backend Environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy file này thành .env.lightningai rồi điền giá trị thực.
#
# Usage:
#   docker compose -f docker-compose.lightningai.yml --env-file .env.lightningai up -d
#
# Sau khi thay đổi .env.lightningai, restart services:
#   docker compose -f docker-compose.lightningai.yml --env-file .env.lightningai up -d --force-recreate
# ─────────────────────────────────────────────────────────────────────────────

# ── LightningAI Public URL ────────────────────────────────────────────────────
# URL công khai của metadata-service trên LightningAI
# Format: https://8002-<workspace-id>.cloudspaces.litng.ai
# Dùng để tạo download links và để frontend trỏ đến
# → Sau khi lấy URL này, cập nhật NEXT_PUBLIC_API_BASE_URL trên VPS
LIGHTNINGAI_PUBLIC_URL=https://8002-YOUR-WORKSPACE-ID.cloudspaces.litng.ai

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=mcpt
POSTGRES_USER=mcpt_user
# QUAN TRỌNG: Dùng mật khẩu mạnh.
# Tránh dùng ký tự đặc biệt @ # % trong mật khẩu — các ký tự này cần
# URL-encode trong DATABASE_URL (@ → %40, # → %23, % → %25).
# Đơn giản nhất: chỉ dùng chữ cái, số, và dấu gạch dưới/gạch ngang.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_NO_SPECIAL_CHARS
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# PostgreSQL connection URL — phải khớp với POSTGRES_* ở trên
# Format: postgresql+psycopg2://USER:PASSWORD@postgres:5432/DBNAME
# Nếu mật khẩu có ký tự đặc biệt, URL-encode nó trong chuỗi này
DATABASE_URL=postgresql+psycopg2://mcpt_user:CHANGE_ME_STRONG_PASSWORD_NO_SPECIAL_CHARS@postgres:5432/mcpt

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# QUAN TRỌNG: Tạo key mạnh với lệnh:
#   openssl rand -base64 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_ALGORITHM=HS256

# ── Bootstrap Admin (tạo lần đầu chạy) ───────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@tracex.example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# ── Storage Paths ─────────────────────────────────────────────────────────────
# Các đường dẫn này là bind mount vào /workspace/ của LightningAI
# Đảm bảo các thư mục này tồn tại trước khi chạy:
#   mkdir -p /workspace/storage/videos /workspace/storage/traces
#   mkdir -p /workspace/storage/queue /workspace/storage/candidate-previews

# URL công khai cho static files (evidence videos, traces)
# Trỏ về domain VPS hoặc LightningAI URL
STORAGE_BASE_URL=https://tracex-ai.smartnovi.tech/storage

# Workspace root trên LightningAI
A20_ROOT=/workspace/a20-root

# ── AI Models ─────────────────────────────────────────────────────────────────
# Cache HuggingFace và Torch tại /workspace/models (bind mount)
HF_HOME=/workspace/models/huggingface
TORCH_HOME=/workspace/models/torch

# Translation model
SEAMLESS_MODEL=facebook/seamless-m4t-v2-large

# TRANSFORMERS_OFFLINE=1: dùng model đã download, không kết nối internet
# TRANSFORMERS_OFFLINE=0: cho phép download model khi thiếu
TRANSFORMERS_OFFLINE=1

# ── Google Drive (tùy chọn) ───────────────────────────────────────────────────
# Đặt false nếu không dùng Google Drive (video lưu local)
GOOGLE_DRIVE_ENABLED=false
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_DRIVE_VINUNI_FOLDER_ID=

# ── Storage Ingest ────────────────────────────────────────────────────────────
# Tự động đẩy file từ /workspace/storage vào queue
# Thường để false và upload manual
STORAGE_INGEST_ENABLED=false

# ── Tracking Timeouts ─────────────────────────────────────────────────────────
# Tăng nếu video dài hoặc GPU chậm
TRACKING_REQUEST_TIMEOUT_SECONDS=600
TRACKING_HEALTH_TIMEOUT_SECONDS=10
TRACKING_STARTUP_MAX_WAIT_SECONDS=120
TRACKING_STARTUP_POLL_INTERVAL_SECONDS=10
TRACKING_STARTUP_RETRY_ATTEMPTS=3

# ── Trace Settings ────────────────────────────────────────────────────────────
MAX_TRACE_WINDOW_HOURS=168
DEFAULT_TRACE_WINDOW_HOURS=24
VIDEO_MERGE_ENABLED=true
MAX_SEGMENTS_PER_TRACE=50
# Render song song từng clip trace, nhưng giữ thấp để không nghẽn query/embed.
TRACE_CLIP_PARALLEL_WORKERS=2
TRACE_CLIP_FFMPEG_THREADS=2
# 0 = tự tính timeout validate theo kích thước file clip.
TRACE_CLIP_VALIDATE_TIMEOUT_SECONDS=0

# ── Search Settings ───────────────────────────────────────────────────────────
MIN_FUSION_SCORE=0.0
MAX_CANDIDATES=50
