# TraceX-AI Environment — LightningAI Deployment
# Copy to .env.lightningai and fill in your values
# Usage: docker compose -f backend/services/lightningai-compose.yml --env-file .env.lightningai up -d

# ==================== Required ====================
# LightningAI public URL (get from LightningAI workspace settings)
# e.g. https://8000-xxxxxxxx.cloudspaces.litng.ai
COOLIFY_PUBLIC_URL=https://YOUR-LIGHTNINGAI-URL

# ==================== Database ====================
POSTGRES_DB=video_tracking
POSTGRES_USER=mcpt_user
# IMPORTANT: Change this to a strong password in production!
POSTGRES_PASSWORD=change-me-use-openssl-rand-base64-32
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==================== Auth ====================
# IMPORTANT: Generate with: openssl rand -base64 64
JWT_SECRET_KEY=change-me-use-openssl-rand-base64-64
JWT_ALGORITHM=HS256

# ==================== Bootstrap Admin ====================
# Default admin user created on first startup
BOOTSTRAP_ADMIN_EMAIL=admin@tracex.example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# ==================== Storage ====================
# VPS domain for static file serving
STORAGE_BASE_URL=https://tracex-ai.smartnovi.tech/storage
A20_ROOT=/workspace/a20-root

# ==================== AI Models ====================
SEAMLESS_M4T_MODEL=facebook/seamless-m4t-v2-large
HF_HOME=/workspace/models/huggingface
TORCH_HOME=/workspace/models/torch
TRANSFORMERS_OFFLINE=0

# ==================== Tracking Timeouts ====================
TRACKING_REQUEST_TIMEOUT_SECONDS=600
TRACKING_HEALTH_TIMEOUT_SECONDS=10
TRACKING_STARTUP_MAX_WAIT_SECONDS=120
TRACKING_STARTUP_POLL_INTERVAL_SECONDS=10
TRACKING_STARTUP_RETRY_ATTEMPTS=3

# ==================== Service URLs (internal) ====================
QUERY_SERVICE_URL=http://query-service:8003
TRACE_SERVICE_URL=http://trace-service:8004
METADATA_SERVICE_URL=http://metadata-service:8002

# ==================== Google Drive (optional) ====================
GOOGLE_DRIVE_ENABLED=false
