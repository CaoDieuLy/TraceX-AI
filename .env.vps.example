# TraceX-AI Environment — VPS Frontend Deployment
# Copy to .env.vps and fill in your values
# This file is for Coolify VPS deployment (frontend only)
# Backend services run on LightningAI — set NEXT_PUBLIC_API_BASE_URL to LightningAI URL

# IMPORTANT: Set this to your LightningAI public URL + /api/v1
# Example: https://8000-xxxxxxxx.cloudspaces.litng.ai/api/v1
NEXT_PUBLIC_API_BASE_URL=https://YOUR-LIGHTNINGAI-URL/api/v1
