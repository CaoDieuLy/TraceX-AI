# =============================================================================
# MCPT — MASTER SECRET TEMPLATE
# =============================================================================
# Copy file này thành secrets/master.env và điền giá trị thật:
#   cp secrets/master.env.example secrets/master.env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mcpt_user
POSTGRES_PASSWORD=<STRONG_DB_PASSWORD>
POSTGRES_DATABASE=mcpt

# --- JWT ---
JWT_SECRET_KEY=<RANDOM_32_CHAR_STRING>

# --- Admin Bootstrap ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<ADMIN_PASSWORD>
BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# --- LightningAI / Tracking Service (REQUIRED) ---
# URL cập nhật sau mỗi lần restart LightningAI API Builder
TRACKING_SERVICE_URL=https://8000-<HASH>.cloudspaces.litng.ai
LIGHTNING_API_TOKEN=<LIGHTNING_BEARER_TOKEN>
LIGHTNING_API_AUTH_HEADER=Authorization
LIGHTNING_API_AUTH_PREFIX=Bearer
TRACKING_SERVICE_PREFER_LOCAL=false
TRACKING_REQUEST_TIMEOUT_SECONDS=30
TRACKING_HEALTH_TIMEOUT_SECONDS=5
TRACKING_STARTUP_MAX_WAIT_SECONDS=8

# --- Google Drive (Optional) ---
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_MAKE_PUBLIC=true
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_VINUNI_FOLDER_ID=
GOOGLE_DRIVE_SOURCE_STORAGE_FOLDER_ID=
MCPT_OAUTH2_CREDENTIALS_FILE=oauth/oauth2_credentials.json
MCPT_OAUTH2_TOKEN_FILE=oauth/oauth2_token.pickle

# --- Storage ---
STORAGE_INGEST_ENABLED=true
STORAGE_INGEST_ROOT=/workspace/storage
VIDEO_STORAGE_ROOT=/workspace/storage/videos

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://metadata-service:8000
