# =============================================================================
# MCPT — MASTER SECRET TEMPLATE
# =============================================================================
# Copy file này thành secrets/master.env và điền giá trị thật:
#   cp secrets/master.env.example secrets/master.env
#   nano secrets/master.env
# Sau đó chạy: bash scripts/sync_secrets.sh
# =============================================================================

# --- VPS Access ---
VPS_HOST=<VPS_IP>
VPS_USER=root
VPS_PASSWORD=<VPS_ROOT_PASSWORD>
VPS_REPO_PATH=/opt/mcpt/A20-App-119

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mcpt_user
POSTGRES_PASSWORD=<STRONG_DB_PASSWORD>
POSTGRES_DATABASE=mcpt_video_tracking_full
POSTGRES_DB=mcpt_video_tracking_full

# --- JWT ---
JWT_SECRET_KEY=<RANDOM_32_CHAR_STRING>

# --- LightningAI / Tracking Service ---
# Cập nhật sau mỗi lần restart LightningAI API Builder
NEXT_PUBLIC_API_BASE_URL =https://8000-<HASH>.cloudspaces.litng.ai
LIGHTNING_API_ENDPOINT=/api/v1/ingestion/process
LIGHTNING_API_TOKEN=<LIGHTNING_BEARER_TOKEN>
LIGHTNING_API_AUTH_HEADER=Authorization
LIGHTNING_API_AUTH_PREFIX=Bearer
TRACKING_SERVICE_URL=https://8000-<HASH>.cloudspaces.litng.ai
TRACKING_SERVICE_PREFER_LOCAL=false

# --- Google Drive ---
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_MAKE_PUBLIC=true
GOOGLE_DRIVE_ROOT_FOLDER_ID=<GOOGLE_DRIVE_FOLDER_ID_ROOT>
GOOGLE_DRIVE_VINUNI_FOLDER_ID=<GOOGLE_DRIVE_FOLDER_ID_VINUNI>
GOOGLE_DRIVE_SOURCE_STORAGE_FOLDER_ID=<GOOGLE_DRIVE_FOLDER_ID_STORAGE>
MCPT_OAUTH2_CREDENTIALS_FILE=oauth/oauth2_credentials.json
MCPT_OAUTH2_TOKEN_FILE=oauth/oauth2_token.pickle

# --- Queue Worker ---
QUEUE_PARALLEL_JOBS=3
QUEUE_POLL_INTERVAL_SECONDS=30
QUEUE_MAX_SIZE=32
STORAGE_INGEST_BATCH_SIZE=150
STORAGE_INGEST_SAMPLE_FPS=5
STORAGE_INGEST_SOURCE_BACKEND=google_drive
STORAGE_INGEST_MIN_FILE_AGE_SECONDS=2

# --- Frontend ---
NEXT_PUBLIC_API_GATEWAY_URL=http://<VPS_IP>
CORS_ALLOWED_ORIGINS=http://<VPS_IP>,http://localhost:3000

# --- Internal Service URLs ---
METADATA_SERVICE_URL=http://metadata-service:8000
AI_SERVICE_URL=http://ai_service:8001

# --- Storage Paths ---
VIDEO_STORAGE_ROOT=/workspace/storage/videos
QUEUE_LOCAL_ROOT=/workspace/storage/queue
STORAGE_INGEST_ROOT=/workspace/storage/storage
QUEUE_VIDEO_FOLDER_NAME=Videos
STORAGE_INGEST_ENABLED=true
MCPT_SECRETS_ROOT=/workspace/a20-root/secrets
MCPT_SHARED_ENV_FILE=/workspace/a20-root/secrets/shared.env
