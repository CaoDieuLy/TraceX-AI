# Backend (gateway + metadata đi kèm) — URL DB cho driver Postgres metadata.
# Sao chép secrets từ `secrets/` và `secret/` trong repo nếu cần; đổi mật khẩu trước khi production.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mcpt_user
POSTGRES_PASSWORD=Mcpt@2026!Secure
POSTGRES_DATABASE=video_tracking
POSTGRES_DB=video_tracking

METADATA_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_URL=http://ai_service:8001
TRACKING_SERVICE_URL=https://8000-01kppzj3vfk1jkf77eb52czjqk.cloudspaces.litng.ai
LIGHTNING_API_TOKEN=abc123
LIGHTNING_API_AUTH_HEADER=Authorization
LIGHTNING_API_AUTH_PREFIX=Bearer

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000

JWT_SECRET_KEY=change-me-in-production

MCPT_SECRETS_ROOT=/workspace/a20-root/secrets
MCPT_SHARED_ENV_FILE=/workspace/a20-root/secrets/shared.env

GOOGLE_DRIVE_ENABLED=true
QUEUE_LOCAL_ROOT=/workspace/storage/queue
