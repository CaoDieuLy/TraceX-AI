MCPT_SECRETS_ROOT=/workspace/project/secrets
MCPT_SHARED_ENV_FILE=/workspace/project/secrets/shared.env

POSTGRES_DB=mcpt
POSTGRES_USER=mcpt_user
POSTGRES_PASSWORD=mcpt_password
POSTGRES_BIND_HOST=0.0.0.0
POSTGRES_PORT=5432

API_GATEWAY_BIND_HOST=0.0.0.0
API_GATEWAY_PORT=8000
METADATA_SERVICE_BIND_HOST=0.0.0.0
METADATA_SERVICE_PORT=8001
TRACKING_SERVICE_BIND_HOST=0.0.0.0
TRACKING_SERVICE_PORT=8002
FRONTEND_BIND_HOST=0.0.0.0
FRONTEND_PORT=3000

METADATA_SERVICE_URL=http://metadata-service:8000
TRACKING_SERVICE_URL=https://your-lightning-service.cloudspaces.litng.ai
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

JWT_SECRET_KEY=change-me-in-production
VIDEO_STORAGE_ROOT=/workspace/storage/videos
QUEUE_LOCAL_ROOT=/workspace/storage/queue
QUEUE_MAX_SIZE=32
QUEUE_POLL_INTERVAL_SECONDS=30

GOOGLE_DRIVE_ENABLED=true
MCPT_OAUTH2_CREDENTIALS_FILE=oauth/oauth2_credentials.json
MCPT_OAUTH2_TOKEN_FILE=oauth/oauth2_token.pickle
GOOGLE_DRIVE_VINUNI_FOLDER_ID=
GOOGLE_DRIVE_MAKE_PUBLIC=true

# Video conversion settings
VIDEO_CONVERSION_OUTPUT_DIR=/workspace/storage/video-conversion
VIDEO_DOWNLOAD_OUTPUT_DIR=/workspace/storage/tracking-outputs
FFMPEG_CRF=28
FFMPEG_PRESET=medium
FFMPEG_AUDIO_CODEC=aac
FFMPEG_OVERWRITE_OUTPUT=false

# Lightning AI GPU service
LIGHTNING_API_BASE_URL=https://your-lightning-service.cloudspaces.litng.ai
LIGHTNING_API_ENDPOINT=/api/v1/ai/worker
LIGHTNING_API_TOKEN=your_lightning_token
LIGHTNING_API_AUTH_HEADER=Authorization
LIGHTNING_API_AUTH_PREFIX=Bearer
LIGHTNING_TIMEOUT_SECONDS=180
