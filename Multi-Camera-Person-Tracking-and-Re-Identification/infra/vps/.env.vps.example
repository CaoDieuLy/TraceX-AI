MCPT_SECRETS_ROOT=/opt/mcpt/secrets
MCPT_SHARED_ENV_FILE=/opt/mcpt/secrets/shared.env

PUBLIC_DOMAIN=search-engine-119.smartnovi.tech
LETSENCRYPT_EMAIL=you@example.com

POSTGRES_DB=mcpt
POSTGRES_USER=mcpt_user
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432

API_GATEWAY_BIND_HOST=127.0.0.1
API_GATEWAY_PORT=18000
METADATA_SERVICE_BIND_HOST=127.0.0.1
METADATA_SERVICE_PORT=18001
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=13000
TRACKING_SERVICE_BIND_HOST=127.0.0.1
TRACKING_SERVICE_PORT=18002

METADATA_SERVICE_URL=http://metadata-service:8000
TRACKING_SERVICE_URL=https://your-tracking-service.cloudspaces.litng.ai
NEXT_PUBLIC_API_GATEWAY_URL=
CORS_ALLOWED_ORIGINS=https://search-engine-119.smartnovi.tech,http://search-engine-119.smartnovi.tech

JWT_SECRET_KEY=change-this-jwt-secret
VIDEO_STORAGE_ROOT=/workspace/storage/videos
QUEUE_LOCAL_ROOT=/workspace/storage/queue
QUEUE_MAX_SIZE=32
QUEUE_POLL_INTERVAL_SECONDS=30

GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_CREDENTIALS_FILE=/opt/mcpt/secrets/google-drive/drive-sa.json
GOOGLE_DRIVE_VINUNI_FOLDER_ID=your_google_drive_folder_id
GOOGLE_DRIVE_MAKE_PUBLIC=true

LIGHTNING_API_BASE_URL=https://your-lightning-service.cloudspaces.litng.ai
LIGHTNING_API_ENDPOINT=/api/v1/ai/worker
LIGHTNING_API_TOKEN=your_lightning_token_here
LIGHTNING_API_AUTH_HEADER=Authorization
LIGHTNING_API_AUTH_PREFIX=Bearer
LIGHTNING_TIMEOUT_SECONDS=180
