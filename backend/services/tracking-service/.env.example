# =====================================================
# MCPT Tracking Service – Environment Configuration
# =====================================================

# ─── Application ───
APP_NAME=mcpt-tracking-service
TRACKING_RUNTIME_MODE=design_ready

# ─── GPU / Hardware ───
UVICORN_WORKERS=1

# ─── Paths ───
LEGACY_ROOT=/workspace/backend/legacy-engine
INGESTION_WORK_ROOT=/workspace/storage/tracking-ingestion
VIDEO_CONVERSION_OUTPUT_DIR=/workspace/storage/video-conversion
VIDEO_DOWNLOAD_OUTPUT_DIR=/workspace/storage/tracking-outputs

# ─── Google Drive ───
GOOGLE_DRIVE_ENABLED=true
MCPT_OAUTH2_CREDENTIALS_FILE=oauth/oauth2_credentials.json
MCPT_OAUTH2_TOKEN_FILE=oauth/oauth2_token.pickle
GOOGLE_DRIVE_MAKE_PUBLIC=true

# GDrive folder structure for queue artifact publishing
GDRIVE_BASE_FOLDER=VinUni
GDRIVE_QUEUE_FOLDER=Storage
GDRIVE_QUEUE_METADATA_SUBFOLDER=Metadata

# ─── PostgreSQL ───
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=video_tracking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

MAX_QUEUE_SIZE=100
QUEUE_FIFO_ENABLED=true

# ─── Video Conversion ───
FFMPEG_CRF=28
FFMPEG_PRESET=medium
FFMPEG_AUDIO_CODEC=aac
FFMPEG_OVERWRITE_OUTPUT=false

# ─── Lightning AI (GPU inference) ───
LIGHTNING_API_BASE_URL=https://your-studio.lightning.ai
LIGHTNING_API_ENDPOINT=/api/v1/ai/worker
LIGHTNING_API_TOKEN=your_lightning_api_token_here
LIGHTNING_API_AUTH_HEADER=Authorization
LIGHTNING_API_AUTH_PREFIX=Bearer
LIGHTNING_TIMEOUT_SECONDS=180

# ─── Feature Flags ───
ENABLE_TRACKEVAL=true
ENABLE_GEOMETRY_GATING=true
ENABLE_CORRECTIVE_CASCADE=true
