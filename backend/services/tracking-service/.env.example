# Example environment variables for tracking-service
# Copy to .env and configure

# Service
SERVICE_NAME=tracking-service
HOST=0.0.0.0
PORT=8000

# Storage paths
STORAGE_ROOT=/storage
MODEL_CACHE_DIR=/storage/model_cache
VIDEO_CACHE_DIR=/storage/video_cache

# Model weights
MCPT_RF_DETR_WEIGHTS=/storage/model-weights/rf-detr/rf-detr-xxlarge.pth

# Processing
MCPT_METADATA_WORKERS=8
MCPT_DETECTOR_BATCH_SIZE=8
MCPT_STREAM_BATCH_SIZE=150
