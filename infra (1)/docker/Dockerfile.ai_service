FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /vendor/metadata-service
COPY backend/services/metadata-service/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/services/metadata-service/app ./app
COPY backend/legacy-engine /workspace/backend/legacy-engine
COPY shared_secret_runtime.py /workspace/a20-root/shared_secret_runtime.py

WORKDIR /app
COPY ai_service/aiapp ./aiapp

ENV PYTHONPATH=/vendor/metadata-service:/app:/workspace/a20-root
ENV A20_ROOT=/workspace/a20-root

EXPOSE 8001

CMD ["uvicorn", "aiapp.main:app", "--host", "0.0.0.0", "--port", "8001"]
