# Canonical secret storage
MCPT_SECRETS_ROOT=/workspace/project/secrets
MCPT_SHARED_ENV_FILE=/workspace/project/secrets/shared.env
MCPT_OAUTH2_CREDENTIALS_FILE=/workspace/project/secrets/oauth/oauth2_credentials.json
MCPT_OAUTH2_TOKEN_FILE=/workspace/project/secrets/oauth/oauth2_token.pickle

# Choose one or both providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Default model
DEFAULT_MODEL=claude-sonnet-4-20250514
# DEFAULT_MODEL=gpt-4o

# Logging
LOG_LEVEL=INFO

# AI Hook Logging (set by instructor)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=lMfm8NPzHVHlOtYx2kOQ7c9PTxJOB0E3DJbD_UBlsFw
AI_LOG_DIR=.ai-log

# MCPT stack
POSTGRES_DB=mcpt
POSTGRES_USER=mcpt_user
# IMPORTANT: Change this to a strong password in production!
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_PORT=5432

# ==================== JWT Security ====================
# IMPORTANT: Generate a secure random key (min 32 chars)
# Example: openssl rand -base64 64
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256

# ==================== Service Ports ====================
METADATA_SERVICE_PORT=8001
API_GATEWAY_PORT=8000
FRONTEND_PORT=3000

# ==================== Lightning AI ====================
LIGHTNING_API_BASE_URL=
LIGHTNING_API_ENDPOINT=/api/v1/ai/worker
LIGHTNING_API_TOKEN=
LIGHTNING_API_AUTH_HEADER=Authorization
LIGHTNING_API_AUTH_PREFIX=Bearer
LIGHTNING_TIMEOUT_SECONDS=180

# ==================== Queue Worker ====================
QUEUE_MAX_SIZE=32
QUEUE_POLL_INTERVAL_SECONDS=30
QUEUE_LOCAL_ROOT=/workspace/storage/queue
QUEUE_VIDEO_FOLDER_NAME=Videos
STORAGE_INGEST_ENABLED=true
STORAGE_INGEST_ROOT=/workspace/storage/storage
STORAGE_INGEST_BATCH_SIZE=50
STORAGE_INGEST_MIN_FILE_AGE_SECONDS=2
INGESTION_WORK_ROOT=/workspace/storage/tracking-ingestion

# ==================== Google Drive ====================
# IMPORTANT: Set to true to enable Google Drive sync
GOOGLE_DRIVE_ENABLED=true

# OAuth2 Google Drive credential files
MCPT_OAUTH2_CREDENTIALS_FILE=oauth/oauth2_credentials.json
MCPT_OAUTH2_TOKEN_FILE=oauth/oauth2_token.pickle

# Drive folder structure for optional queue publishing:
# - Root: GOOGLE_DRIVE_VINUNI_FOLDER_ID or GOOGLE_DRIVE_ROOT_FOLDER_ID
# - Subfolders: VinUni/Storage/<video-folder>, VinUni/Storage/Metadata
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_VINUNI_FOLDER_ID=

# Folder names (do not change unless you know what you're doing)
GOOGLE_DRIVE_VINUNI_FOLDER_NAME=VinUni
GOOGLE_DRIVE_QUEUE_FOLDER_NAME=Storage
GOOGLE_DRIVE_METADATA_FOLDER_NAME=Metadata

# Set to true to make uploaded files publicly readable (optional)
# WARNING: This makes videos accessible to anyone with the link
GOOGLE_DRIVE_MAKE_PUBLIC=false

# ==================== CORS ====================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# ==================== Logging (Optional) ====================
LOG_LEVEL=INFO
